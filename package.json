{
  "name": "fanta-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:pwa": "npm run build && node scripts/build-pwa.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "test:ticket11": "npm run build && node --test tests/ticket11.test.mjs",
    "test:ticket12": "npm run build && node --test tests/ticket12.test.mjs",
    "test:ticket13": "npm run build && node --test tests/ticket13.test.mjs",
    "test:ticket14": "npm run build && node --test tests/ticket14.test.mjs",
    "test:ticket15": "npm run build && node --test tests/ticket15.test.mjs",
    "test:ticket16": "npm run build && node --test tests/ticket16.test.mjs",
    "test:ticket17": "npm run build && node --test tests/ticket17.test.mjs",
    "test:ticket18": "npm run build && node --test tests/ticket18.test.mjs",
    "test:ticket19": "npm run build && node --test tests/ticket19.test.mjs",
    "test:ticket20": "npm run build && node --test tests/ticket20.test.mjs",
    "test:ticket21": "npm run build && node --test tests/ticket21.test.mjs",
    "test:ticket22": "npm run build && node --test tests/ticket22.test.mjs",
    "test:pwa": "node --test tests/pwa.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
